# goal definition
string filename                      # Bag name. Ending in .bag saves exactly that name;
                                     # otherwise the current datetime + .bag is appended
                                     #   "test" -> test2018-05-23-10-04-20.bag
                                     #   "test.bag" -> test.bag
TopicDetails[] topics                # Topics to include. Empty = every buffered topic
builtin_interfaces/Time start_time   # Earliest message to include. time(0) = each topic's oldest buffered message
builtin_interfaces/Time stop_time    # Latest message to include. time(0) = each topic's newest buffered message
bool use_h264                        # Compress image topics with h264
bool throttle_msgs                   # Apply each topic's configured throttle period; false = every message in range
bool use_interval_mode               # Interpret start_time/stop_time as an interval around msg_timestamp
                                     # instead of as absolute times
builtin_interfaces/Time  msg_timestamp  # Timestamp of the message that triggered the snapshot; kept out of
                                        # interval_mode_tolerance rounding so that message is never missed
float32 interval_mode_tolerance       # interval_mode window: [msg_timestamp - tolerance, msg_timestamp + tolerance]
bool interval_mode_single_msg        # Write one message for CameraInfo/ImageMarker/compressed Image/
                                     # interval_single_msg_types topics: exact stamp == msg_timestamp preferred,
                                     # else closest with a warning. false = every message in the interval
string rosbag_preset_profile         # rosbag2 storage profile. Empty = default profile
string profile                       # Named capture profile (capture_profiles_dir) selecting topics and their
                                     # max_rate_hz. Empty = topics (or all buffered) honoring throttle_msgs.
                                     # A profile's max_rate_hz always applies, unlike throttle_msgs
float32 post_duration_s              # >0 defers writing until this many seconds after goal acceptance (or
                                     # until canceled), producing a forward/live capture that also includes
                                     # messages arriving after the trigger; buffering is otherwise unchanged.
                                     # 0 (default) writes immediately from what's already buffered. Rejected
                                     # at goal-acceptance time if it exceeds the node's max_post_duration_s
bool use_flat_output                 # false (default): filename becomes a bag directory (rosbag2's usual
                                     # <filename>/<basename>_0.mcap + metadata.yaml). true: only the single
                                     # self-describing .mcap is kept, moved to exactly filename
---
# result definition
bool success                         # True if snapshot successfully written to disk
string NO_DATA_MESSAGE=no messages buffered on selected topics
string message                       # Error description if failed
---
#feedback definition
float32 progress                     # Progress of the snapshot in percentage
float32 duration                     # Duration of the compression process in seconds
string message                       # Current status of the snapshot
